---
/**
 * A stylised Shopify customer-account page, rebuilt in HTML so it stays sharp and
 * responsive. Mirrors the App Store listing artwork (docs/listing/listing-assets-v3).
 * variant: which blocks to show.
 */
interface Props {
  variant: 'orders' | 'status' | 'profile';
}
const {variant} = Astro.props;
---

<div class={`mock mock-${variant}`}>
  <div class="mock-top">
    <span class="shop-mark"></span>
    <span class="shop-name">Sarah’s Shop</span>
    <span class="avatar">S</span>
  </div>

  {variant !== 'status' && (
    <div class="tabs">
      <span class={variant === 'orders' ? 'tab on' : 'tab'}>Orders</span>
      <span class={variant === 'profile' ? 'tab on' : 'tab'}>Profile</span>
    </div>
  )}

  {variant === 'orders' && (
    <>
      <div class="block banner" data-label="Banner">
        <span class="tick">✓</span>
        <div>
          <strong>Welcome back, Sarah</strong>
          <p>Your order #1001 is on its way — track it anytime.</p>
        </div>
        <span class="banner-cta">Track order</span>
      </div>

      <div class="order">
        <div class="order-head">
          <div><strong>Order #1001</strong><p class="dim">May 24, 2026</p></div>
          <span class="pill warn">Out for delivery</span>
        </div>
        <div class="order-foot">
          <div class="thumbs"><i class="t1"></i><i class="t2"></i></div>
          <div class="right"><strong>$749.95</strong><p class="link">View order</p></div>
        </div>
      </div>

      <div class="order">
        <div class="order-head">
          <div><strong>Order #1000</strong><p class="dim">May 12, 2026</p></div>
          <span class="pill ok">Delivered</span>
        </div>
        <div class="order-foot">
          <div class="thumbs"><i class="t1"></i><i class="t2"></i><i class="t3"></i></div>
          <div class="right"><strong>$129.00</strong><p class="link">View order</p></div>
        </div>
      </div>

      <div class="block pay-row" data-label="Payment icons">
        <span class="pay visa">VISA</span>
        <span class="pay mc"><i></i><i></i></span>
        <span class="pay amex">AMEX</span>
        <span class="pay pp">PayPal</span>
        <span class="pay sp">shop</span>
      </div>
    </>
  )}

  {variant === 'status' && (
    <>
      <p class="crumb">‹ Orders</p>
      <h4 class="mock-h">Order #1001</h4>
      <p class="dim">Placed May 24, 2026</p>
      <div class="order plain">
        <div class="status-line">
          <span class="tick solid">✓</span>
          <div><strong>Out for delivery</strong><p class="dim">Estimated arrival May 28 · Standard shipping</p></div>
        </div>
        <div class="track">
          <div><p class="lbl">Tracking number</p><p class="mono">1Z999AA10123456784</p></div>
          <span class="link">Track</span>
        </div>
        <div class="block badges" data-label="Trust badges">
          <strong class="badges-h">Shop with confidence</strong>
          <ul>
            <li><span class="ic">🔒</span><div><strong>Secure checkout</strong><p class="dim">SSL-encrypted payment</p></div></li>
            <li><span class="ic">💲</span><div><strong>Money-back guarantee</strong><p class="dim">30-day money-back</p></div></li>
            <li><span class="ic">🚚</span><div><strong>Fast shipping</strong><p class="dim">Ships within 24 hours</p></div></li>
            <li><span class="ic">✅</span><div><strong>Authentic products</strong><p class="dim">100% genuine, guaranteed</p></div></li>
          </ul>
        </div>
      </div>
      <div class="block support" data-label="Support">
        <span class="sup">✉ Email us</span>
        <span class="sup">💬 WhatsApp</span>
        <span class="sup">❔ Help center</span>
      </div>
    </>
  )}

  {variant === 'profile' && (
    <>
      <div class="order plain row-card">
        <span class="avatar big">SJ</span>
        <div><strong>Sarah Johnson</strong><p class="dim">sarah.johnson@example.com</p></div>
        <span class="link">Edit</span>
      </div>
      <div class="block prefs" data-label="Profile capture">
        <strong>Your preferences</strong>
        <p class="dim">Tell us a bit about yourself so we can tailor offers to you.</p>
        <p class="lbl">Birthday</p>
        <div class="field"><span>🗓</span> May 2, 1994</div>
        <p class="lbl">What would you like to hear about?</p>
        <ul class="checks">
          <li><i class="box on">✓</i> New arrivals</li>
          <li><i class="box on">✓</i> Sales &amp; promotions</li>
          <li><i class="box"></i> Birthday offers</li>
          <li><i class="box"></i> Back-in-stock alerts</li>
        </ul>
        <span class="save">Save</span>
      </div>
    </>
  )}
</div>

<style>
  .mock {
    background: var(--surface);
    /* The hero sits on the gradient and sets colour: #fff — the mock is its own
       surface, so it has to re-assert the page ink or its text disappears. */
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 20px;
    font-size: 13.5px;
    line-height: 1.45;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .mock > *, .order > *, .order-head > *, .order-foot > * { min-width: 0; }
  .mock strong { font-weight: 650; font-size: 13.5px; }
  .mock p { font-size: 12.5px; }
  .dim { color: var(--muted); }
  .link { color: var(--brand-600); font-weight: 600; }
  .lbl { font-weight: 650; color: var(--ink-2); margin-top: 10px !important; font-size: 12px !important; }
  .mono { font-family: var(--font-mono); font-size: 12px; color: var(--ink-2); overflow-wrap: anywhere; }

  .mock-top { display: flex; align-items: center; gap: 10px; }
  .shop-mark { width: 26px; height: 26px; border-radius: 8px; background: linear-gradient(135deg, #7b8cf5, #6366f1); }
  .shop-name { font-weight: 700; }
  .avatar {
    margin-left: auto; width: 26px; height: 26px; border-radius: 50%;
    background: var(--accent-soft); color: var(--accent-ink);
    display: grid; place-items: center; font-size: 11px; font-weight: 700;
  }
  .avatar.big { margin: 0; width: 34px; height: 34px; font-size: 12px; }

  .tabs { display: flex; gap: 20px; border-bottom: 1px solid var(--line); padding-bottom: 8px; }
  .tab { color: var(--muted); font-size: 12.5px; font-weight: 600; position: relative; }
  .tab.on { color: var(--brand-600); }
  .tab.on::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -9px;
    height: 2px; background: var(--brand-600); border-radius: 2px;
  }

  /* Anything Optimalify adds gets the dashed brand outline + a label. */
  .block { position: relative; border-radius: 12px; }
  .block[data-label]::before {
    content: attr(data-label);
    position: absolute; top: -9px; left: 12px; z-index: 1;
    background: var(--brand-gradient); color: #fff;
    font-size: 9.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    padding: 2px 8px; border-radius: 999px;
  }

  .banner {
    display: flex; align-items: center; gap: 10px;
    background: var(--success-soft); padding: 14px 16px;
  }
  .banner strong { color: var(--success-ink); }
  .banner p { color: var(--success-ink); opacity: .85; }
  .banner-cta { margin-left: auto; color: var(--success-ink); font-weight: 700; font-size: 12px; white-space: nowrap; }
  .tick {
    width: 20px; height: 20px; flex: 0 0 20px; border-radius: 50%;
    background: var(--success-ink); color: #fff; display: grid; place-items: center; font-size: 11px;
  }
  .tick.solid { background: #0e7038; }

  .order { border: 1px solid var(--line); border-radius: 12px; padding: 14px; display: grid; gap: 12px; }
  .order.plain { box-shadow: none; }
  .order.row-card { grid-auto-flow: column; grid-template-columns: auto 1fr auto; align-items: center; }
  .order-head, .order-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .order-foot .right { text-align: right; }
  .thumbs { display: flex; gap: 8px; }
  .thumbs i { width: 30px; height: 30px; border-radius: 8px; display: block; }
  .t1 { background: linear-gradient(135deg, #f6b8c0, #efa2ad); }
  .t2 { background: linear-gradient(135deg, #b9cdf3, #a3bdee); }
  .t3 { background: linear-gradient(135deg, #bfe3bd, #a8d8a6); }

  .pill { font-size: 11px; font-weight: 650; padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
  .pill.ok { background: var(--success-soft); color: var(--success-ink); }
  .pill.warn { background: var(--warn-soft); color: var(--warn-ink); }

  .pay-row { display: flex; flex-wrap: wrap; gap: 8px; border: 1px dashed var(--line-strong); padding: 16px 14px 12px; }
  .pay {
    height: 24px; min-width: 40px; padding: 0 8px; border-radius: 5px;
    border: 1px solid rgba(22, 22, 34, 0.12); background: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 9.5px; font-weight: 800; letter-spacing: .02em; color: #3d3f45;
  }
  .pay.visa { color: #1a1f71; } .pay.amex { color: #1476c6; }
  .pay.pp { color: #253b80; } .pay.sp { color: #5a31f4; }
  .pay.mc { gap: 0; } .pay.mc i { width: 11px; height: 11px; border-radius: 50%; }
  .pay.mc i:first-child { background: #eb001b; }
  .pay.mc i:last-child { background: #f79e1b; margin-left: -4px; }

  .crumb { color: var(--brand-600); font-weight: 600; font-size: 12px !important; }
  .mock-h { font-size: 17px; font-weight: 700; }

  .status-line { display: flex; gap: 10px; align-items: flex-start; }
  .track { display: flex; justify-content: space-between; align-items: flex-end; border-top: 1px solid var(--line); padding-top: 12px; }

  .badges { border: 1px dashed var(--line-strong); padding: 18px 14px 14px; margin-top: 4px; }
  .badges-h { display: block; margin-bottom: 10px; }
  .badges ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .badges li { display: flex; gap: 8px; align-items: flex-start; }
  .ic { font-size: 14px; line-height: 1.2; }

  .support { display: flex; flex-wrap: wrap; gap: 8px; border: 1px dashed var(--line-strong); padding: 18px 14px 14px; }
  .sup { font-size: 11.5px; color: var(--ink-2); background: var(--surface-2); border: 1px solid var(--line); border-radius: 999px; padding: 4px 10px; }

  .prefs { border: 1px dashed var(--line-strong); padding: 18px 14px 14px; display: grid; gap: 4px; }
  .field {
    display: flex; align-items: center; gap: 8px;
    border: 1px solid var(--line-strong); border-radius: 8px; padding: 8px 10px;
    font-size: 12.5px; color: var(--ink-2); margin-top: 4px;
  }
  .checks { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 7px; }
  .checks li { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--ink-2); }
  .box {
    width: 15px; height: 15px; border-radius: 4px; border: 1.5px solid var(--line-strong);
    display: grid; place-items: center; font-size: 10px; font-style: normal; color: transparent;
  }
  .box.on { background: var(--brand-600); border-color: var(--brand-600); color: #fff; }
  .save {
    justify-self: start; margin-top: 12px; background: #1f2430; color: #fff;
    font-size: 12px; font-weight: 650; padding: 8px 18px; border-radius: 8px;
  }

  @media (max-width: 520px) {
    .mock { padding: 14px; }
    .badges ul { grid-template-columns: 1fr; }
    .banner { flex-wrap: wrap; }
    .banner-cta { margin-left: 30px; }
  }
</style>
