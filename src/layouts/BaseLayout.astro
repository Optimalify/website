---
import '../styles/global.css';
import {SITE, listingUrl, type Surface} from '../config';
import Logo from '../components/Logo.astro';
import {
  alternatePath, defaultLocale, htmlLang, localeFromPath, localeName, locales, ogLocale, withLocale,
} from '../i18n';
import {ui} from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  /** Page-specific <title>; the home page uses the bare brand name. */
  bare?: boolean;
  /** Which surface of the site this is — becomes utm_medium on the install links. */
  surface?: Surface;
  /** Open Graph type; blog posts pass `article`. */
  ogType?: 'website' | 'article';
  /** ISO date, only for `article`. */
  publishedTime?: string;
  tags?: string[];
  /** Force a locale (the shared 404 page); otherwise it comes from the URL. */
  locale?: 'ja' | 'en';
  /** Page has no counterpart in the other locale (404): skip hreflang and the switcher target. */
  noAlternates?: boolean;
}

const {
  title,
  description = ui[forcedLocale ?? localeFromPath(Astro.url.pathname)].siteDescription,
  bare = false,
  surface = 'landing',
  ogType = 'website',
  publishedTime,
  tags = [],
  locale: forcedLocale,
  noAlternates = false,
} = Astro.props;
const locale = forcedLocale ?? localeFromPath(Astro.url.pathname);
const t = ui[locale];
const L = (path: string) => withLocale(path, locale);
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const other = locales.find((l) => l !== locale)!;
const abs = (path: string) => new URL(path, SITE.url).href;
const alternates = noAlternates
  ? []
  : locales.map((l) => ({hreflang: htmlLang[l], href: abs(alternatePath(pathname, l))}));
const switchHref = noAlternates ? withLocale('/', other) : alternatePath(pathname, other);
const installHref = listingUrl(surface);
const pageTitle = bare ? title : `${title} — ${SITE.name}`;
const installLabel = t.install;
const canonical = abs(pathname);
const ogImage = new URL('/img/og.png', SITE.url).href;
---

<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {alternates.length > 0 && <meta property="og:locale:alternate" content={ogLocale[other]} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={abs(alternatePath(pathname, defaultLocale))} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title={t.blog.feedTitle} href={L('/rss.xml')} />
    <slot name="head" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#4f46e5" />
  </head>
  <body>
    <div class="lang-bar" id="lang-bar" hidden data-page={locale}>
      <span>{t.langBar.text}</span>
      <a href={switchHref} hreflang={htmlLang[other]} lang={htmlLang[other]} data-lang-pick>{t.langBar.link}</a>
      <button type="button" id="lang-bar-close" aria-label={t.langBar.dismiss}>×</button>
    </div>
    <header class="site-head">
      <div class="wrap head-inner">
        <a href={L('/')} class="brand" aria-label={t.homeLabel}>
          <Logo size={30} />
          <span>{SITE.name}</span>
        </a>
        <nav class="head-nav">
          <a href={L('/#features')}>{t.nav.features}</a>
          <a href={L('/#how')}>{t.nav.how}</a>
          <a href={L('/demo')}>{t.nav.demo}</a>
          <a href={L('/blog')}>{t.nav.blog}</a>
          <a href={L('/help')}>{t.nav.help}</a>
          <span class="lang-switch" role="group" aria-label={t.switcherLabel}>
            {locales.map((l) => (
              l === locale ? (
                <span class="on" aria-current="true" lang={htmlLang[l]}>{localeName[l]}</span>
              ) : (
                <a href={switchHref} hreflang={htmlLang[l]} lang={htmlLang[l]} data-lang-pick>{localeName[l]}</a>
              )
            ))}
          </span>
          <a href={installHref} class="btn btn-primary btn-sm">{installLabel}</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <div class="foot-brand">
          <a href={L('/')} class="brand"><Logo size={26} /><span>{SITE.name}</span></a>
          <p class="foot-note">{t.footNote}</p>
        </div>
        <div class="foot-cols">
          <div>
            <h4>{t.foot.product}</h4>
            <a href={L('/#features')}>{t.foot.features}</a>
            <a href={L('/#how')}>{t.foot.how}</a>
            <a href={L('/demo')}>{t.foot.demo}</a>
            <a href={L('/#pricing')}>{t.foot.pricing}</a>
            <a href={L('/#faq')}>{t.foot.faq}</a>
            <a href={L('/founding')}>{t.foot.founding}</a>
            <a href={L('/blog')}>{t.foot.blog}</a>
          </div>
          <div>
            <h4>{t.foot.helpCenter}</h4>
            <a href={L('/help/getting-started')}>{t.foot.gettingStarted}</a>
            <a href={L('/help/add-blocks-in-editor')}>{t.foot.addBlocks}</a>
            <a href={L('/help')}>{t.foot.allGuides}</a>
          </div>
          <div>
            <h4>{t.foot.contact}</h4>
            <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>
            <a href={L('/legal')}>{t.foot.legal}</a>
            <a href={L('/llms.txt')}>llms.txt</a>
          </div>
        </div>
      </div>
      <div class="wrap foot-legal">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span>{t.foot.notAffiliated}</span>
      </div>
    </footer>

    <script is:inline>
      // Suggest the other language once, never redirect: crawlers and shared links keep their URL.
      (function () {
        try {
          var bar = document.getElementById('lang-bar');
          var page = bar.getAttribute('data-page');
          var pref = localStorage.getItem('optimalify-lang');
          var browserJa = (navigator.language || '').toLowerCase().indexOf('ja') === 0;
          var mismatch = page === 'ja' ? !browserJa : browserJa;
          if (!pref && mismatch) bar.hidden = false;
          document.getElementById('lang-bar-close').addEventListener('click', function () {
            localStorage.setItem('optimalify-lang', page); bar.hidden = true;
          });
          document.querySelectorAll('[data-lang-pick]').forEach(function (a) {
            a.addEventListener('click', function () {
              localStorage.setItem('optimalify-lang', a.getAttribute('hreflang'));
            });
          });
        } catch (e) {}
      })();
    </script>

    <style>
      .site-head {
        position: sticky; top: 0; z-index: 50;
        background: color-mix(in srgb, var(--page) 88%, transparent);
        backdrop-filter: saturate(160%) blur(12px);
        border-bottom: 1px solid var(--line);
      }
      .head-inner { display: flex; align-items: center; justify-content: space-between; height: 66px; gap: 24px; }
      .brand {
        display: inline-flex; align-items: center; gap: 10px;
        color: var(--ink); font-weight: 750; font-size: 1.06rem; letter-spacing: -0.02em;
      }
      .brand:hover { text-decoration: none; }
      .head-nav { display: flex; align-items: center; gap: 26px; }
      .head-nav a { color: var(--ink-2); font-size: 0.95rem; font-weight: 550; }
      .head-nav a:hover { color: var(--brand-600); text-decoration: none; }
      .lang-switch { display: inline-flex; gap: 2px; font-size: 0.85rem; border: 1px solid var(--line); border-radius: 999px; padding: 2px; }
      .lang-switch a, .lang-switch .on { padding: 4px 11px; border-radius: 999px; font-size: 0.85rem; }
      .lang-switch a { color: var(--ink-2); }
      .lang-switch .on { background: var(--accent-soft); color: var(--accent-ink); font-weight: 650; }
      .lang-bar {
        display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap;
        padding: 8px 40px 8px 16px; background: var(--accent-soft); color: var(--accent-ink);
        font-size: 0.88rem; position: relative; line-height: 1.5;
      }
      .lang-bar[hidden] { display: none; }
      .lang-bar a { font-weight: 650; text-decoration: underline; }
      .lang-bar button {
        position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
        background: none; border: none; color: inherit; font-size: 1.3rem; cursor: pointer; padding: 4px 10px;
      }
      .btn-sm { padding: 9px 18px; font-size: 0.9rem; }
      .head-nav .btn-primary { color: #fff; }

      .site-foot { border-top: 1px solid var(--line); background: var(--surface-2); margin-top: 40px; }
      .foot-inner > * { min-width: 0; }
      .foot-inner {
        display: grid; grid-template-columns: 1.4fr 2fr; gap: 48px;
        padding-top: 56px; padding-bottom: 40px;
      }
      .foot-note { color: var(--muted); font-size: 0.92rem; margin-top: 14px; max-width: 34ch; }
      .foot-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
      .foot-cols h4 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 14px; font-weight: 650; }
      .foot-cols a { display: block; color: var(--ink-2); font-size: 0.93rem; padding: 5px 0; }
      .foot-legal {
        display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
        border-top: 1px solid var(--line); padding-top: 20px; padding-bottom: 32px;
        color: var(--muted); font-size: 0.85rem;
      }

      @media (max-width: 860px) {
        .foot-inner { grid-template-columns: 1fr; gap: 36px; }
        .head-nav a:not(.btn):not([data-lang-pick]) { display: none; }
      }
      @media (max-width: 520px) {
        .foot-cols { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </body>
</html>
