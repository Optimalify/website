---
import BaseLayout from '../layouts/BaseLayout.astro';
import {SITE} from '../config';
import {ui} from '../i18n/ui';

// GitHub Pages serves one 404.html for every path, so this page is bilingual.
const ja = ui.ja.notFound;
const en = ui.en.notFound;
---
<BaseLayout title={ja.title} description={ja.description} locale="ja" noAlternates>
  <section class="nf wrap">
    <span class="eyebrow">404</span>
    <h1>{ja.heading}</h1>
    <p class="lede" set:html={ja.body} />
    <p class="mail">{ja.still} <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a></p>
    <hr />
    <h2 lang="en">{en.heading}</h2>
    <p class="lede" lang="en" set:html={en.body} />
  </section>
</BaseLayout>
<style>
  .nf { padding: 110px 24px 140px; max-width: 620px; text-align: center; }
  .nf h1 { margin: 20px 0 16px; }
  .nf h2 { font-size: 1.3rem; margin: 0 0 12px; }
  .nf hr { border: none; border-top: 1px solid var(--line); margin: 40px 0 32px; }
  .mail { margin-top: 26px; color: var(--muted); font-size: 0.93rem; }
</style>
