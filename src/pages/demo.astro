---
import BaseLayout from '../layouts/BaseLayout.astro';
import {SITE, installLabel, listingUrl} from '../config';

const installHref = listingUrl('demo');

const pages = [
  {
    title: 'Orders',
    image: '/img/demo/orders.png',
    alt: 'Orders page with a banner, a welcome card with a button, and Download invoice buttons on each order',
    width: 1056,
    height: 715,
    blocks: 'Banner, Rich content, Invoice',
    text: 'A notice and a welcome card sit above the order list. Each order gets a Download invoice button.',
  },
  {
    title: 'Orders, further down',
    image: '/img/demo/orders-bottom.png',
    alt: 'Bottom of the Orders page with a FAQ list, social links and a support footer',
    width: 1356,
    height: 870,
    blocks: 'FAQ, Social links, Support',
    text: 'Common questions, your social profiles and your contact options, right under the orders.',
  },
  {
    title: 'Order status',
    image: '/img/demo/order-status.png',
    alt: 'Order status page with payment icons, a banner, store policies and a trust badge',
    width: 1056,
    height: 880,
    blocks: 'Payment icons, Store policies, Trust badges',
    text: 'Payment methods, expandable policies and a trust badge beside the delivery details.',
  },
  {
    title: 'Profile',
    image: '/img/demo/profile.png',
    alt: 'Profile page with a birthday field and contact preference checkboxes',
    width: 1356,
    height: 640,
    blocks: 'Profile',
    text: 'Customers save their birthday and what they want to hear about.',
  },
  {
    title: 'Custom page',
    image: '/img/demo/page.png',
    alt: 'A size guide page in the customer account menu',
    width: 1356,
    height: 310,
    blocks: 'Pages',
    text: 'Add your own page, such as a size guide, to the account menu.',
  },
];
---

<BaseLayout
  title="Demo: see every block in a customer account"
  description="See how Optimalify blocks look on Shopify customer account pages: Orders, Order status, Profile and custom pages."
  surface="demo"
>
  <section class="wrap demo-head">
    <h1>See it in a customer account</h1>
    <p>
      These are the real blocks on our demo store. The text is sample content, and you write your
      own in the app.
    </p>
    <a href={installHref} class="btn btn-primary">{installLabel}</a>
  </section>

  <section class="wrap demo-list">
    {pages.map((page) => (
      <article>
        <h2>{page.title}</h2>
        <p class="blocks">{page.blocks}</p>
        <p>{page.text}</p>
        <img src={page.image} alt={page.alt} width={page.width} height={page.height} />
      </article>
    ))}
  </section>

  <section class="wrap demo-end">
    <h2>Try it on your store</h2>
    <p>The Free plan covers one block. Questions? Email <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>.</p>
    <a href={installHref} class="btn btn-primary">{installLabel}</a>
  </section>
</BaseLayout>

<style>
  .demo-head { padding-top: 56px; padding-bottom: 32px; }
  .demo-head p { max-width: 640px; margin: 12px 0 22px; font-size: 1.1rem; }
  .demo-list article { margin: 0 0 56px; }
  .demo-list h2 { margin: 0 0 4px; }
  .demo-list p { margin: 0 0 8px; }
  .demo-list .blocks { font-weight: 650; color: var(--brand-600); }
  .demo-list img {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 14px;
    border: 1px solid #e4e4ee;
    border-radius: 12px;
  }
  .demo-end { padding-bottom: 72px; }
  .demo-end p { margin: 8px 0 18px; }
</style>
