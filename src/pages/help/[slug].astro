---
import type {GetStaticPaths} from 'astro';
import {getCollection, render} from 'astro:content';
import HelpLayout from '../../layouts/HelpLayout.astro';

export const getStaticPaths = (async () => {
  const articles = await getCollection('help');
  return articles
    .filter((a) => a.id !== 'index')
    .map((entry) => ({params: {slug: entry.id}, props: {entry}}));
}) satisfies GetStaticPaths;

const {entry} = Astro.props;
const {Content} = await render(entry);
---
<HelpLayout title={entry.data.title} description={entry.data.description} slug={entry.id}>
  <Content />
</HelpLayout>
