---
import {render} from 'astro:content';
import HelpLayout from '../layouts/HelpLayout.astro';
import {slugOf, type HelpArticle} from '../utils/blog';
import type {Locale} from '../i18n';

interface Props {
  entry: HelpArticle;
  locale: Locale;
}
const {entry, locale} = Astro.props;
const {Content} = await render(entry);
---
<HelpLayout title={entry.data.title} description={entry.data.description} slug={slugOf(entry.id)} locale={locale}>
  <Content />
</HelpLayout>
